# NOTE: config/*.js files are generated from CSV but ARE tracked in git
# They need to be committed so GitHub Pages can serve them to the browser.
# Do NOT add config/*.js to gitignore!
#
# Scope (13 Aug 2026): config/*.csv and the generated config/*.js belong to the retired
# Spring 2026 pipeline and are kept only because the CST395/CST349 spring pages read them
# at render time. The Fall 2026 courses do not use them — each Fall course's assignment
# registry is its own schedule.html. See skills/writing-assignments/SKILL.md.

# Local Netlify folder
.netlify

_pgbackup/
pinegrow.json

# Retired files staged for manual deletion. The sandbox cannot delete on the mount, so
# files are moved here instead. Git history is the archive — no need to publish these.
_to_delete/
