        apply(tick.checked);
        tick.addEventListener('change', function () {
            apply(tick.checked);
            try { window.localStorage.setItem(TICK_KEY, tick.checked ? '1' : '0'); } catch (e) { /* not remembered */ }
        });
    }());

    // ---------- clipboard ----------
    function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        ta.style.top = (window.pageYOffset || 0) + 'px';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok ? Promise.resolve() : Promise.reject(new Error('no clipboard'));
    }
    function writeClipboard(text, html) {
        var nc = null;
        try { nc = navigator.clipboard; } catch (e) { nc = null; }
        if (html && nc && nc.write && window.ClipboardItem) {
            var p;
            try {
                p = nc.write([new ClipboardItem({
                    'text/html': new Blob([html], { type: 'text/html' }),
                    'text/plain': new Blob([text], { type: 'text/plain' })
                })]);
            } catch (e) { p = Promise.reject(e); }
            return p.catch(function () { return nc.writeText ? nc.writeText(text) : fallbackCopy(text); }).catch(function () { return fallbackCopy(text); });
        }
        if (nc && nc.writeText) {
            try { return nc.writeText(text).catch(function () { return fallbackCopy(text); }); }
            catch (e) { return fallbackCopy(text); }
        }
        return fallbackCopy(text);
    }
    function selectNear(btn) {
        var box = btn.parentNode ? btn.parentNode.querySelector('.ct') : null;
        if (!box || !window.getSelection) { return; }
        try { var r = document.createRange(); r.selectNodeContents(box); var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); } catch (e) { /* nothing more to try */ }
    }
    // copy buttons on the Dojo prompts
    $all('.copybtn').forEach(function (btn) {
        var label = btn.textContent;
        var timer = null;
        btn.addEventListener('click', function () {
            writeClipboard(btn.getAttribute('data-copy') || '').then(function () {
                btn.textContent = 'Copied';
                btn.classList.add('done');
                announce('Copied');
                if (timer) { clearTimeout(timer); }
                timer = setTimeout(function () {
                    btn.textContent = label;
                    btn.classList.remove('done');
                    if (live) { live.textContent = ''; }
                }, 2000);
            }, function () { selectNear(btn); });
        });
    });

    // ---------- AI feedback on what is written in a box ----------
    var SYS_STEP = "You are helping a student make one box of a graded item precise. In this graded item the student reports the first step they took toward their Sprint 2 goal and what it produced, says which part of the STAR answer they wrote in week 8 got closer to real because of it, and names the next step with a day. Use only the criteria for this box, listed below. Reply in two or three sentences, in plain words: first what the box already does, quoting their words, then the one thing that would make it precise, asked as a question or named as what is missing. If the box meets its criteria, make your first sentence exactly \"This box meets the criteria.\" and follow it with one question that would make it sharper, offered, not required. Never rewrite the student's box and never hand them wording. Do not supply a step, an outcome, a connection or a next step for them. A step that produced less than planned, reported with what was learned and how the student will improve, meets the criteria the same way as one that went to plan; never suggest hiding it. Do not judge the person, their ability or their prospects, and do not use pass/fail language.";
    var META = {
        t1: { coach: 'CRITERIA: a step, a day, a person or thing involved; an outcome a second person would see as concrete and meaningful, and where it is; if less than expected, what was learned and how the student will improve; if different from the plan, what changed.' },
        t2: { coach: 'CRITERIA: one STAR part named and how this step moved it, or "none yet" with the reason.' },
        t3: { coach: 'CRITERIA: one action, a day, and how it moves the student closer to the Sprint 2 goal.' }
    };
    function showAi(el, text, n) {
        el.style.display = 'block';
        el.innerHTML = '';
        var lbl = document.createElement('span');
        lbl.className = 'lbl';
        lbl.textContent = n > 1 ? ('AI feedback · round ' + n) : 'AI feedback';
        el.appendChild(lbl);
        el.appendChild(document.createTextNode(text));
    }
    function boxLabel(key) { var l = $('label[for="bx-' + key + '"]'); return l ? clean(l.textContent) : key; }
    function questionFor(key) {
        var ta = document.getElementById('bx-' + key);
        var q = ta ? document.getElementById(ta.getAttribute('data-q')) : null;
        var st = document.getElementById('st-' + key);
        return (q ? clean(q.textContent) + ' ' : '') + 'Box: ' + boxLabel(key) + (st ? ' Starter: ' + clean(st.textContent) : '');
    }
    function otherLines(key) {
        var s = '';
        TASKS.forEach(function (t) {
            if (t.key === key) { return; }
            var ta = document.getElementById('bx-' + t.key);
            s += '- Task ' + t.n + ' (' + t.label + '): ' + ((ta && clean(ta.value)) || '(empty)') + '\n';
        });
        return s;
    }
    function askAi(key, ta, btn, box, refresh) {
        var meta = META[key];
        if (!meta) { return; }
        var st = answerState(key);
        var text = ta.value.trim();
        var content = 'PAGE: ' + PAGE.title + ' (' + PAGE.course + ', Week ' + PAGE.week + ', graded item)\n' +
            'THE BOX THEY ARE WRITING: ' + questionFor(key) + '\n\n' +
            'WHAT THEY WROTE:\n"""' + text + '"""\n\n' +
            'THE OTHER BOXES OF THEIR PAGE (context only; give feedback on the box above):\n' + otherLines(key) + '\n' +
            'COACH NOTES (ground truth for you, not to be quoted back wholesale):\n' + meta.coach;
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Reading what you wrote...';
        box.style.display = 'block';
        box.innerHTML = '<span class="lbl">AI feedback</span>Reading what you wrote...';
        fetch(AI_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ system: SYS_STEP, messages: [{ role: 'user', content: content }], max_tokens: 320 })
        }).then(function (r) {
            if (!r.ok) { throw new Error('status ' + r.status); }
            return r.json();
        }).then(function (data) {
            var reply = String(data.content || data.text || '').trim();
            if (!reply) { throw new Error('empty'); }
            st.ai.push({ at: new Date().toISOString(), onText: text, text: reply });
            save();
            showAi(box, reply, st.ai.length);
        }).catch(function () {
            box.style.display = 'block';
            box.innerHTML = '<span class="lbl">AI feedback</span><span class="err">Could not get feedback right now. Your answer is saved; try the button again later.</span>';
        }).then(function () { btn.textContent = label; refresh(); });
    }
    $all('textarea[data-key]').forEach(function (ta) {
        var key = ta.getAttribute('data-key');
        var st = answerState(key);
        ta.value = st.text || '';
        var btn = $('[data-ai="' + key + '"]');
        var box = $('[data-aibox="' + key + '"]');
        if (st.ai.length && box) { showAi(box, st.ai[st.ai.length - 1].text, st.ai.length); }
        function refresh() {
            if (!btn) { return; }
            var t = ta.value.trim();
            var last = st.ai.length ? st.ai[st.ai.length - 1].onText : null;
            btn.disabled = t.length === 0 || t === last;
        }
        ta.addEventListener('input', function () { st.text = ta.value; refresh(); saveSoon(); });
        ta.addEventListener('blur', save);
        if (btn && box) { btn.addEventListener('click', function () { askAi(key, ta, btn, box, refresh); }); }
        refresh();
    });

    // ---------- the task text, read from the markup ----------
    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function taskParts(t) {
        var tt = document.getElementById('q-' + t.key);
        var g = tt ? $('em.guide', tt) : null;
        var guide = g ? clean(g.textContent) : '';
        var q = tt ? clean(tt.textContent) : '';
        if (guide && q.slice(-guide.length) === guide) { q = clean(q.slice(0, q.length - guide.length)); }
        return { q: q, guide: guide };
    }
    function checksFor(t) {
        return $all('#task-' + t.n + ' ul.cks li').map(function (li) {
            var cb = $('input', li);
            return { text: clean($('label', li).textContent), on: !!(cb && cb.checked) };
        });
    }

    // ---------- Copy the questions (format of cst499/quality-review.html) ----------
    function buildQuestions() {
        var md = '', html = '';
        TASKS.forEach(function (t, idx) {
            var p = taskParts(t);
            var head = 'Task ' + t.n + ' — ' + t.label;
            md += head + '\n' + p.q + (p.guide ? ' *' + p.guide + '*' : '') + '\n';
            html += '<p><b>' + esc(head) + '</b><br>' + esc(p.q) + (p.guide ? ' <em>' + esc(p.guide) + '</em>' : '') + '</p>';
            var cks = checksFor(t);
            if (cks.length) {
                md += '\n   Check it yourself:\n';
                html += '<p><b>Check it yourself:</b></p><ul style="list-style:none;padding-left:0">';
                cks.forEach(function (c) { md += '   [ ] ' + c.text + '\n'; html += '<li>[ ] ' + esc(c.text) + '</li>'; });
                html += '</ul>';
            }
            if (idx < TASKS.length - 1) { md += '\n'; }
        });
        md += '\nSelf-check\n';
        html += '<p><b>Self-check</b></p><ul style="list-style:none;padding-left:0">';
        $all('ul.selfcheck li').forEach(function (li) {
            var line = clean($('label', li).textContent) + ' · ' + clean($('.pts', li).textContent);
            md += '[ ] ' + line + '\n';
            html += '<li>[ ] ' + esc(line) + '</li>';
        });
        html += '</ul>';
        return { text: md, html: html };
    }
    var tasksBtn = $('#copy-tasks');
    if (tasksBtn) {
        tasksBtn.addEventListener('click', function () {
            var label = tasksBtn.textContent;
            var payload = buildQuestions();
            writeClipboard(payload.text, payload.html).then(function () {
                tasksBtn.textContent = 'Copied';
                announce('Copied');
                setTimeout(function () { tasksBtn.textContent = label; }, 2000);
            }, function () {
                tasksBtn.textContent = 'Copy did not work — use Copy my answers below';
                announce(tasksBtn.textContent);
                setTimeout(function () { tasksBtn.textContent = label; }, 4000);
            });
        });
    }

    // ---------- Copy my answers (format of cst349/my-sprint-2-goal.html) ----------
    function txt(key) { return (answerState(key).text || '').trim(); }
    function block(label, key) { var a = txt(key); return label + '\n' + (a ? indentLines(a, '   ') : '   (no answer yet)') + '\n\n'; }
    function buildText() {
        var out = PAGE.title + ' — ' + PAGE.course + ', Week ' + PAGE.week + '\n\n';
        var tickLabel = $('label[for="dojo-tick"] b');
        out += (dojoOn() ? '[x] ' : '[ ] ') + (tickLabel ? clean(tickLabel.textContent) : '') + '\n\n';
        TASKS.forEach(function (t) {
            var p = taskParts(t);
            out += 'Task ' + t.n + ' · ' + t.label + '\n' + p.q + (p.guide ? ' *' + p.guide + '*' : '') + '\n\n';
            out += block(boxLabel(t.key), t.key);
        });
        if (dojoOn()) {
            var d = txt('dojosum');
            if (d) { out += DOJO_LABEL + '\n' + indentLines(d, '   ') + '\n\n'; }
        }
        out += 'SELF-CHECK (ticked by me; the grader verifies each line)\n';
        var total = 0;
        $all('ul.selfcheck li').forEach(function (li) {
            var cb = $('input[data-check]', li), on = cb && cb.checked;
            var pts = parseInt(($('.pts', li).textContent.match(/\d+/) || ['0'])[0], 10);
            if (on) { total += pts; }
            out += (on ? '[x] ' : '[ ] ') + clean($('label', li).textContent) + ' · ' + pts + ' pts\n';
        });
        out += 'Self-check total: ' + total + ' of 100\n';
        return out.replace(/\n+$/, '\n');
    }

    // ---------- ticks: remembered on this browser; the Self-check ticks are copied with the answers ----------
    function scTotal() {
        var t = 0;
        $all('ul.selfcheck li').forEach(function (li) {
            var cb = $('input[data-check]', li);
            if (cb && cb.checked) { t += parseInt(($('.pts', li).textContent.match(/\d+/) || ['0'])[0], 10); }
        });
        var el = $('#sc-total');
        if (el) { el.textContent = t + ' of 100 points ticked'; }
    }
    $all('input[data-check]').forEach(function (cb) {
        var id = cb.getAttribute('data-check');
        cb.checked = !!state.checks[id];
        cb.addEventListener('change', function () { state.checks[id] = cb.checked; save(); scTotal(); });
    });
    scTotal();

    var copyBtn = $('#copy-btn'), copyStatus = $('#copy-status'), summaryOut = $('#summary-out');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            var text = buildText();
            summaryOut.value = text;
            state.copiedAt = new Date().toISOString();
            save();
            writeClipboard(text).then(function () {
                copyStatus.className = 'status ok';
                copyStatus.textContent = 'Copied. Paste it into the Canvas text box. The same text is below if you need it again.';
            }, function () {
                copyStatus.className = 'status';
                copyStatus.textContent = 'Copy did not work in this browser. Select the text below and copy it by hand.';
                summaryOut.focus();
                summaryOut.select();
            });
        });
    }
    if (!storageOK) { showStoreNote(); }
}());
</script>
<script>
/* Task rail — progress and position (from cst499/quality-review.html). Additive: if it throws, the page is unchanged. */
(function () {
    'use strict';
    var N = 3;
    var count = document.getElementById('rail-count');
    var links = {};
    for (var i = 1; i <= N; i++) { links[i] = document.querySelector('.rail-steps a[data-rail="' + i + '"]'); }
    function refresh() {
        var done = 0;
        for (var i = 1; i <= N; i++) {
            var ta = document.getElementById('bx-t' + i), a = links[i];
            var filled = !!(ta && ta.value.trim().length > 0);
            if (filled) { done++; }
            if (a) { a.classList.toggle('done', filled); }
        }
        if (count) { count.textContent = done + '/' + N; }
    }
    for (var j = 1; j <= N; j++) {
        var t = document.getElementById('bx-t' + j);
        if (t) { t.addEventListener('input', refresh); }
    }
    refresh();
    var here = 0;
    function mark() {
        var top = (document.querySelector('.rail') || {}).offsetHeight || 54;
        var cur = 0;
        for (var i = 1; i <= N; i++) {
            var el = document.getElementById('task-' + i);
            if (el && el.getBoundingClientRect().top - top - 24 <= 0) { cur = i; }
        }
        if (cur === here) { return; }
        if (here && links[here]) { links[here].classList.remove('here'); }
        if (cur && links[cur]) { links[cur].classList.add('here'); }
        here = cur;
    }
    var ticking = false;
    function onScroll() {
        if (ticking) { return; }
        ticking = true;
        window.requestAnimationFrame(function () { mark(); ticking = false; });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    mark();
}());
</script>
