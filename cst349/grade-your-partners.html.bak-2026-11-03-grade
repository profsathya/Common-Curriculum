<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grade your partners | CST349</title>
<!-- grade-your-partners.md in this folder is the editable companion to this page: the words are edited there and carried into this file. The page design (purpose chain, self-check, copy) is that of cst349/my-first-step-taken.html; the roster inputs and datalist are those of cst349/sprint-1-exam-paired.html; the look back and look forward are those of the CST286 Sprint 3 pages. No Dojo route on this page. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --blue:#0374B5; --blue-dark:#0a5a8a; --text:#2D3B45; --muted:#5C6873;
    --border:#C7CDD1; --border-light:#E8EAEC; --teal:#0F766E; --check:#0A7340;
    --font:"Lato","Helvetica Neue",Helvetica,Arial,sans-serif;
    --paper:#F4F3EC; --card:#FCFBF6; --ink:#22303C; --ink-soft:#5C6B74;
    --line:#DAD6C7; --line-soft:#E7E4D8;
    --blaze:#B04A18; --hero-ink:#131F2B; --hero-cream:#EFE9D6;
    --warn:#6F5612;
    --t-phone:#2F6BA8; --t-phone-soft:#E2EAF3;
    --tc:var(--t-phone); --tsoft:var(--t-phone-soft);
    --on-tc:#FFFFFF;
    --rail-h:54px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#141C24; --card:#1B242E; --ink:#E8E4D6; --ink-soft:#9FABB2;
      --line:#31404C; --line-soft:#26333E;
      --blaze:#E0793C; --blue:#6BAEDC; --blue-dark:#9CCBEA; --teal:#5FC9BE; --warn:#D6B04A; --check:#6FCF97;
      --t-phone:#7FA9D6; --t-phone-soft:#22313F; --on-tc:#131F2B;
    }
  }
  :root[data-theme="dark"]{
    --paper:#141C24; --card:#1B242E; --ink:#E8E4D6; --ink-soft:#9FABB2;
    --line:#31404C; --line-soft:#26333E;
    --blaze:#E0793C; --blue:#6BAEDC; --blue-dark:#9CCBEA; --teal:#5FC9BE; --warn:#D6B04A; --check:#6FCF97;
    --t-phone:#7FA9D6; --t-phone-soft:#22313F; --on-tc:#131F2B;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:"Atkinson Hyperlegible",var(--font); color:var(--ink); background:var(--paper); font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased; overflow-wrap:break-word}
  .page{max-width:1180px; margin:0 auto; padding:22px 22px 56px}
  h1,h2,h3{font-family:Fraunces,Georgia,serif; text-wrap:balance; margin:0}
  a{color:var(--blaze)}
  p{margin:0 0 12px}
  a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--blaze); outline-offset:2px; border-radius:3px}

  .canvasbar{display:flex;flex-wrap:wrap;gap:5px 10px;align-items:baseline;border:1px solid var(--line);border-left:4px solid var(--tc);background:var(--tsoft);color:var(--ink);border-radius:5px;padding:9px 13px;margin:0 0 14px;font-size:14px}
  .canvasbar[hidden]{display:none}
  .canvasbar a{color:var(--blue-dark)}

  .crumb{font-family:"IBM Plex Mono",monospace; font-size:.8rem; letter-spacing:.06em; margin-bottom:12px; color:var(--ink-soft)}
  .crumb a{color:var(--ink-soft); text-decoration:none}
  .crumb a::before{content:"\2190\00a0"}
  .crumb a:hover{color:var(--blaze); text-decoration:underline}

  /* hero */
  .hero{background:var(--hero-ink); color:var(--hero-cream); border-radius:8px; position:relative; overflow:hidden}
  .hero-inner{padding:38px 34px 34px; position:relative; z-index:1}
  .hero .kicker{font-family:"IBM Plex Mono",monospace; font-size:.75rem; letter-spacing:.16em; text-transform:uppercase; color:#9FB2C4; margin:0 0 14px}
  .hero h1{font-size:clamp(1.9rem,4.6vw,2.8rem); font-weight:900; line-height:1.08; letter-spacing:-.01em; color:var(--hero-cream)}
  .hero .intro{font-size:1.08rem; color:#DCE3E8; margin:18px 0 0; max-width:62ch; border-left:3px solid var(--blaze); padding:4px 0 4px 16px}

  /* buttons */
  button{font:inherit}
  .copybtn{font-family:"Atkinson Hyperlegible",var(--font); font-size:.9rem; font-weight:700; padding:8px 14px; min-height:40px; border-radius:5px; cursor:pointer; border:1.5px solid var(--tc); color:var(--tc); background:transparent}
  .copybtn::before{content:"\29C9\00a0\00a0"}
  .copybtn.done::before{content:"\2713\00a0\00a0"}
  .copybtn:hover{filter:brightness(1.1)}

  /* dojo prompts */
  .prompt{display:flex; flex-wrap:wrap; align-items:flex-start; gap:10px 14px; background:var(--paper); border:1px solid var(--line); border-left:3px solid var(--teal); border-radius:5px; padding:12px 14px; margin:0 0 10px; max-width:820px}
  .prompt .ptext{flex:1 1 320px; margin:0; font-family:"IBM Plex Mono",monospace; font-size:.86rem; line-height:1.55; max-width:none}
  .prompt .copybtn{flex:0 0 auto}

  /* provenance */
  .prov2{margin-top:30px; border:1px solid var(--line); border-radius:6px; background:var(--card); padding:0; font-size:.88rem; color:var(--ink)}
  .prov2 .prov-head{padding:12px 16px 0; font-family:"Atkinson Hyperlegible",var(--font); font-size:.95rem; font-weight:700}
  .prov2 .prov-lead{padding:5px 16px 14px; margin:0; line-height:1.55; max-width:none}
  .pagenav{margin-top:20px; padding-top:14px; border-top:1px solid var(--line); font-size:.9rem}
  .pagenav a{color:var(--blue-dark)}
  .pagenav a::before{content:"\2190\00a0"}
  .sr{position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap}

  @media (max-width:520px){
    .page{padding:14px 16px 40px}
    .hero-inner{padding:26px 20px 24px}
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation:none !important; transition:none !important}
  }

  /* ---------- graded item layer (from cst349/my-sprint-2-goal.html) ---------- */
  [hidden]{display:none !important}
  body:not(.dojo-on) .dojo-only{display:none !important}
  body.dojo-on .airow{display:none !important}
  .gibar{margin:14px 0 0; border:1px solid var(--line); border-left:5px solid var(--blaze); background:var(--card); border-radius:5px; padding:11px 16px; font-size:.95rem}
  h2.sec{font-size:1.5rem; font-weight:650; margin:38px 0 12px; padding-bottom:7px; border-bottom:2px solid var(--line)}
  .body{max-width:74ch}
  .choose{display:flex; gap:12px; align-items:flex-start; background:var(--card); border:1px solid var(--line); border-left:5px solid var(--teal); border-radius:5px; padding:14px 16px; margin-top:16px; max-width:900px}
  .choose input{flex:0 0 24px; width:24px; height:24px; margin:2px 0 0; accent-color:var(--tc); cursor:pointer}
  .choose input:focus-visible{outline:3px solid var(--blaze); outline-offset:2px}
  .choose label{cursor:pointer}
  .dojowarn{margin:12px 0 0; max-width:900px; background:#FFF1B8; border:2px solid #B87A00; color:#2E2100; border-radius:6px; padding:12px 16px; font-weight:700}
  .passcode{font-family:"IBM Plex Mono",monospace; font-size:1.05rem; background:var(--card); border:1.5px dashed var(--tc); border-radius:5px; padding:9px 14px; display:inline-block; margin:0 0 14px}
  .dsteps{padding-left:24px; margin:0}
  .dsteps > li{margin:0 0 16px; padding-left:4px}
  .dsteps > li::marker{font-family:"IBM Plex Mono",monospace; font-weight:600; color:var(--tc)}
  #dojo-block{margin-top:6px; max-width:900px}
  #dojo-start{margin-top:16px; max-width:900px}
  .rbox{margin:10px 0 0}
  label.qt{display:block; font-size:.92rem; margin:0 0 6px; color:var(--ink)}
  textarea.box{display:block; width:100%; min-height:120px; font:inherit; font-size:.97rem; line-height:1.5; color:var(--ink); background:var(--paper); border:1px solid var(--line); border-radius:5px; padding:10px 12px; resize:vertical}
  textarea.box.small{min-height:84px}
  textarea.box:focus-visible{outline:3px solid var(--blaze); outline-offset:1px}
  .btn{font:inherit; font-size:.9rem; font-weight:700; padding:8px 14px; min-height:40px; border-radius:5px; cursor:pointer; border:1.5px solid var(--tc); color:var(--tc); background:var(--card)}
  .btn.primary{background:var(--tc); color:var(--on-tc)}
  .btn[disabled]{opacity:.45; cursor:not-allowed}
  .airow{margin:8px 0 0}
  .aibox{display:none; margin:9px 0 0; padding:12px 14px; background:var(--tsoft); border:1px solid var(--line); border-radius:6px; font-size:.93rem; line-height:1.55; white-space:pre-wrap; max-width:74ch}
  .aibox .lbl{display:block; font-family:"IBM Plex Mono",monospace; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; color:var(--tc); font-weight:600; margin-bottom:4px}
  .aibox .err{color:var(--blaze)}
  ul.selfcheck{list-style:none;margin:0 0 4px;padding:0;font-size:14px}
  ul.selfcheck li{display:flex;gap:9px;align-items:flex-start;margin:0 0 9px;line-height:1.5;max-width:74ch}
  ul.selfcheck input{flex:0 0 18px;width:18px;height:18px;margin:2px 0 0;accent-color:var(--blue);cursor:pointer}
  ul.selfcheck input:focus-visible{outline:2px solid var(--blue-dark);outline-offset:2px}
  ul.selfcheck label{flex:1;min-width:0;cursor:pointer}
  ul.selfcheck .pts{flex:0 0 auto;white-space:nowrap;font-weight:700;color:var(--blue-dark);padding-left:6px}
  .sc-total{font-weight:700;margin:6px 0 12px}
  .copywrap{margin:6px 0 0}
  .status{font-size:.9rem; color:var(--ink-soft); margin:8px 0 0}
  .status.ok{color:#1A7F4B; font-weight:700}
  .sumout{display:block; width:100%; min-height:150px; font-family:"IBM Plex Mono",monospace; font-size:.8rem; color:var(--ink); background:var(--paper); border:1px solid var(--line); border-radius:5px; padding:10px 12px; margin-top:4px}
  .storenote{display:none; font-size:.9rem; color:var(--blaze); margin:8px 0 0}
  .instructor{margin-top:22px; text-align:center; font-size:.9rem}
  .instructor .nm{font-weight:700}
  .instructor a,.feedback-note a{color:var(--blue-dark)}
  .feedback-note{margin:18px 0 0; padding-top:14px; border-top:1px solid var(--line); font-size:.86rem; color:var(--ink-soft); text-align:center}
  .page-footer{margin-top:16px; font-size:.78rem; color:var(--ink-soft); text-align:center}
  .page-footer img{height:20px; opacity:.55; vertical-align:middle; margin-right:8px}
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .status.ok{color:#6FCF97} }
  :root[data-theme="dark"] .status.ok{color:#6FCF97}
  details.more{margin:4px 0 0}
  details.more > summary{cursor:pointer; display:inline-flex; align-items:center; gap:8px; min-height:32px; font-weight:700; color:var(--tc); padding:2px 0; list-style:none}
  details.more > summary::-webkit-details-marker{display:none}
  details.more > summary::before{content:"+"; flex:0 0 24px; width:24px; height:24px; border:1.5px solid var(--tc); border-radius:4px; font-family:"IBM Plex Mono",monospace; line-height:21px; text-align:center}
  details.more[open] > summary::before{content:"\2212"}
  details.more[open] > summary{margin-bottom:8px}

  /* ---------- the three-box arrow chain (from cst499/learning-plan-bb.html) ---------- */
  .thread-flow{display:grid;grid-template-columns:1fr auto 1.15fr auto 1fr;align-items:stretch;gap:10px;margin-bottom:22px;max-width:1000px}
  .tbox{background:var(--card);border:1.5px solid var(--line);border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;justify-content:flex-start;font-size:15px;line-height:1.5;color:var(--ink)}
  .tbox .tlbl{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:4px;font-family:"IBM Plex Mono",monospace}
  .tbox.now{background:var(--tsoft);border:2px solid var(--tc);box-shadow:0 2px 8px rgba(3,116,181,.08)}
  .tbox.now .tlbl{color:var(--tc)}
  .tbox p{margin:0}
  .tbox a{font-weight:700}
  .tarrow{display:flex;align-items:center;justify-content:center;color:var(--tc);padding:0 2px}
  .tarrow svg{width:28px;height:28px;stroke:currentColor;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
  /* stacks at the Canvas embed width (754px) and below */
  @media (max-width:820px){
    .thread-flow{grid-template-columns:1fr;gap:6px}
    .tarrow svg{transform:rotate(90deg);width:22px;height:22px}
  }

  /* ---------- the sticky task rail (from cst499/quality-review.html) ---------- */
  .rail{position:sticky;top:0;z-index:40;background:var(--paper);border-bottom:1px solid var(--line)}
  .rail-in{max-width:1180px;margin:0 auto;padding:0 22px;display:flex;align-items:center;gap:1.1rem;height:var(--rail-h)}
  .rail-label{font-family:"IBM Plex Mono",monospace;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap;flex:0 0 auto}
  ol.rail-steps{display:flex;align-items:center;gap:.35rem;list-style:none;margin:0;padding:0;flex:1;min-width:0;overflow-x:auto;scrollbar-width:none}
  ol.rail-steps::-webkit-scrollbar{display:none}
  .rail-steps a{display:flex;align-items:center;gap:.4rem;white-space:nowrap;min-height:32px;padding:.3rem .55rem;border-radius:999px;color:var(--ink-soft);font-size:.82rem;font-weight:700;text-decoration:none}
  .rail-steps a b{display:inline-flex;align-items:center;justify-content:center;width:1.4rem;height:1.4rem;border-radius:999px;border:1.5px solid var(--line);font-size:.75rem;font-weight:700;background:var(--card)}
  .rail-steps a:hover{background:var(--tsoft);color:var(--tc)}
  .rail-steps a.here{color:var(--tc);background:var(--tsoft)}
  .rail-steps a.here b{border-color:var(--tc);color:var(--tc)}
  .rail-steps a.done b{background:var(--check);border-color:var(--check);color:var(--card)}
  .rail-count{font-family:"IBM Plex Mono",monospace;font-size:.8rem;font-weight:600;color:var(--ink-soft);white-space:nowrap}
  @media (max-width:1080px){.rail-steps a span{display:none}}
  @media (max-width:520px){.rail-in{padding:0 16px}}

  /* ---------- tasks: the question, then the box, then the optional layer (from cst499/quality-review.html) ---------- */
  .copyline{display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;margin:0 0 12px;font-size:.95rem;line-height:1.55;max-width:74ch}
  .copyline .btn{flex:0 0 auto}
  .copyline span{flex:1 1 220px;padding-top:8px}
  ol.tasks{list-style:none;margin:0;padding:0;display:grid;gap:18px;max-width:900px}
  ol.tasks > li.task{background:var(--card);border:1px solid var(--line);border-radius:5px;padding:16px 18px 14px;margin:0;scroll-margin-top:calc(var(--rail-h) + 12px)}
  .task .ttext{display:flex;gap:10px;margin:0 0 12px;font-size:1.08rem;line-height:1.5}
  .task .tn{flex:0 0 24px;font-family:"IBM Plex Mono",monospace;font-weight:600;color:var(--tc)}
  .task .tt{flex:1;min-width:0;max-width:74ch}
  em.guide{font-style:italic;color:var(--ink-soft)}
  .task > .rbox{margin:0 0 10px 34px}
  .task > .rbox .starter{white-space:normal}
  div.ckself{margin:12px 0 0;padding-top:8px;border-top:1px solid var(--line-soft)}
  div.ckself h3{font-family:"Atkinson Hyperlegible",var(--font);font-size:.8rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);margin:0 0 6px}
  ul.cks{list-style:none;padding:0;margin:0;font-size:.93rem}
  ul.cks li{display:flex;gap:.55rem;align-items:flex-start;margin:0 0 .4rem;line-height:1.5;max-width:74ch}
  ul.cks input[type="checkbox"]{flex:0 0 18px;width:18px;height:18px;margin:2px 0 0;accent-color:var(--check);cursor:pointer}
  ul.cks input[type="checkbox"]:focus-visible{outline:2px solid var(--blue-dark);outline-offset:2px}
  ul.cks label{cursor:pointer;flex:1;min-width:0}
  .task details.route{margin:0 0 0 34px}
  details.route{border:1px solid var(--line);border-radius:6px;background:var(--paper)}
  details.route > summary{list-style:none;cursor:pointer;padding:11px 14px;display:flex;gap:11px;align-items:flex-start;border-radius:5px}
  details.route > summary::-webkit-details-marker{display:none}
  details.route > summary:hover{background:var(--tsoft)}
  details.route[open] > summary{border-bottom:1px solid var(--line);border-radius:5px 5px 0 0}
  .route .plus{flex:0 0 24px;width:24px;height:24px;border:1.5px solid var(--tc);border-radius:4px;color:var(--tc);font-family:"IBM Plex Mono",monospace;font-weight:600;line-height:21px;text-align:center}
  details.route:not([open]) > summary .plus::after{content:"+"}
  details.route[open] > summary .plus::after{content:"\2212"}
  .route .rt{font-weight:700;color:var(--tc);padding-top:1px}
  .route-body{padding:13px 14px 4px}
  .more-body .example{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--tc);border-radius:5px;padding:10px 14px;margin:0 0 10px;font-size:.93rem;line-height:1.55;max-width:74ch}
  .more-body .example .exl{display:block;font-family:"IBM Plex Mono",monospace;font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px}
  .more-body .example p{margin:0 0 6px}
  .more-body .example p:last-child{margin:0}
  .more-body details.more{margin:0 0 12px}
  .more-body .reflq{margin:0 0 12px;padding:9px 12px 8px;background:var(--tsoft);border-left:3px solid var(--teal);border-radius:0 4px 4px 0;font-size:.93rem;max-width:74ch}
  .more-body .reflq h3{font-family:"Atkinson Hyperlegible",var(--font);font-size:.8rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--teal);margin:0 0 4px}
  .more-body .reflq p{margin:0}
  #dojo-block .rbox{max-width:820px}
  @media (max-width:620px){.task > .rbox,.task details.route{margin-left:0}}

  @media print{
    body{background:#fff; color:#000; font-size:11.5pt}
    .canvasbar,.crumb,.pagenav,.copybtn,.btn,.airow,.choose,.dojo-only,.rail,.copyline{display:none !important}
    details.route::details-content,details.more::details-content{content-visibility:visible !important; display:block !important; height:auto !important}
    .hero{background:none; color:#000; border:0}
    .hero h1,.hero .intro,.hero .kicker{color:#000}
    .hero-inner{padding:0 0 12px}
    .prompt,.task,.tbox,.example{background:none}
    textarea.box{border:1px solid #999; background:none}
    a{color:#000}
  }

  /* ---------- roster form (the inputs and datalist of cst349/sprint-1-exam-paired.html) ---------- */
  .pnamerow{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:0 0 8px;font-size:.92rem}
  .pnamerow label{font-weight:700;color:var(--ink)}
  .pnamerow input{font:inherit;font-size:.97rem;padding:6px 9px;border:1px solid var(--line);border-radius:5px;min-width:240px;color:var(--ink);background:var(--paper)}
  .pnamerow input[type="number"]{min-width:0;width:7em}
  .pnamerow input:focus-visible{outline:3px solid var(--blaze);outline-offset:1px}
  .namewarn{font-size:.9rem;color:var(--blaze);font-weight:700;margin:0 0 8px}
  .fixmsg{margin:10px 0 0;padding:10px 14px;border:1.5px solid var(--blaze);border-radius:5px;background:var(--card);color:var(--ink);font-size:.95rem;max-width:74ch}
  .fixmsg ul{margin:4px 0 0;padding-left:20px}
  ul.cks.agree{margin:8px 0 4px}
  .cmhead{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 12px}
  .cmhead h3{font-size:1.25rem;font-weight:650;flex:1;min-width:0}
  .cmblock .rbox{margin:0}
  .cmblock .cmq{margin-top:14px}
  .addrow{margin:14px 0 0}
  .cmblock label.qt{margin-top:12px}

  /* ---------- look back / look forward (the CST286 Sprint 3 frame, 1 Nov 2026) ---------- */
  .looktask{max-width:900px}
  .looktask > .body{margin-bottom:10px}
  .looktask .rbox{margin:10px 0 0}
  .lookecho{margin:0 0 12px; max-width:900px; padding:10px 14px; background:var(--tsoft); border:1px solid var(--line); border-left:4px solid var(--tc); border-radius:5px; font-size:.95rem; line-height:1.55}
  .lookecho b{display:block; font-family:"IBM Plex Mono",monospace; font-size:.78rem; letter-spacing:.06em; text-transform:uppercase; color:var(--tc); margin-bottom:2px}
  .lookecho q{font-style:italic; white-space:pre-line}
  .lookecho.none{border-left-color:var(--blaze)}
  fieldset.choice{border:0; margin:0 0 6px; padding:0; min-width:0}
  .radios{display:flex; flex-wrap:wrap; gap:10px 22px}
  .radios label{display:inline-flex; align-items:center; gap:8px; cursor:pointer}
  .radios input{width:20px; height:20px; margin:0; accent-color:var(--tc); cursor:pointer}
  .radios input:focus-visible{outline:3px solid var(--blaze); outline-offset:2px}
  .radios.col{flex-direction:column; gap:8px}
