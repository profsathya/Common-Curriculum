        if (!foundEl || !noneEl) { return; }
        var prev = '';
        try {
            if (LOOK.from.leave) { prev = lkGet(LOOK.from.leave) || ''; }
            else {
                var o = JSON.parse(lkGet(LOOK.from.state) || 'null');
                var a = o && o.answers ? o.answers[LOOK.from.field] : null;
                prev = a == null ? '' : String(typeof a === 'object' ? (a.text || '') : a);
            }
        } catch (e) { prev = ''; }
        prev = prev.trim();
        document.getElementById('look-text').textContent = prev;
        foundEl.hidden = !prev;
        noneEl.hidden = !!prev;
    }());
    function lkChoice(name) { var on = $('input[type="radio"][name="' + name + '"]:checked'); return on ? on.value : ''; }
    $all('fieldset.choice[data-name]').forEach(function (fs) {
        var name = fs.getAttribute('data-name');
        $all('input[type="radio"]', fs).forEach(function (r) {
            var was = lkRead(name);
            r.checked = !!was && was === r.value;
            r.addEventListener('change', function () { if (r.checked) { lkWrite(name, r.value); save(); } });
        });
    });
    if (!String(lkRead('leave') || '').trim()) { lkWrite('leave', lkGet(LOOK.leave) || ''); }
    if (LOOK.bind) {
        $all('textarea[data-look]').forEach(function (ta) {
            var k = ta.getAttribute('data-look');
            ta.value = lkRead(k) || '';
            ta.addEventListener('input', function () { lkWrite(k, ta.value); saveSoon(); });
            ta.addEventListener('blur', save);
        });
    }
    var leaveTa = document.getElementById('bx-leave'), leaveTimer = null, leaveWritten = String(lkRead('leave') || '');
    function saveLeave() {
        if (!leaveTa) { return; }
        var v = leaveTa.value;
        if (v === leaveWritten) { return; }
        if (lkSet(LOOK.leave, v.trim() ? v : null)) { leaveWritten = v; }
    }
    if (leaveTa) {
        leaveTa.addEventListener('input', function () { if (leaveTimer) { clearTimeout(leaveTimer); } leaveTimer = setTimeout(saveLeave, 400); });
        leaveTa.addEventListener('blur', saveLeave);
        window.addEventListener('pagehide', saveLeave);
    }
    // Copy my answers: the look back and the look forward, each under its heading, as on the CST286 pages.
    function lookBlock(which) {
        var k = which === 'back' ? 'lookback' : 'leave';
        var fs = $('fieldset.choice[data-name="' + k + '_choice"]'), lab = $('label[for="bx-' + k + '"]');
        if (!fs || !lab) { return ''; }
        var head = which === 'back' ? 'Look back' : 'Look forward';
        var c = lkChoice(k + '_choice'), t = String(lkRead(k) || '').trim();
        return head.toUpperCase() + '\n\n' +
            fs.getAttribute('data-cp-label') + '\n' + (c ? '   ' + c : '   (not chosen yet)') + '\n\n' +
            lkClean(lab.textContent) + '\n' + (t ? indentLines(t, '   ') : '   (no answer yet)') + '\n\n';
    }

    // ---------- one block per classmate; at least one; the count and contents are remembered ----------
    var MIN = 1;
    var FIELDS = ['name', 'lines', 'total', 'q1', 'q2', 'q3', 'q4'];
    if (!Array.isArray(state.blocks)) { state.blocks = []; }
    while (state.blocks.length < MIN) { state.blocks.push({}); }
    var list = document.getElementById('cm-list'), tpl = document.getElementById('cm-tpl');
    function render() {
        if (!list || !tpl) { return; }
        list.innerHTML = '';
        state.blocks.forEach(function (data, i) {
            var n = i + 1;
            var frag = document.importNode(tpl.content, true);
            var li = frag.querySelector('[data-cm]');
            li.id = 'cm-' + n;
            $('[data-cm-title]', li).textContent = CM + ' ' + n;
            var rm = $('[data-cm-remove]', li);
            if (i >= MIN) {
                rm.hidden = false;
                rm.setAttribute('aria-label', 'Remove ' + CM + ' ' + n);
                rm.addEventListener('click', function () { state.blocks.splice(i, 1); save(); render(); });
            }
            var starter = $('[data-starter]', li);
            if (starter) { starter.id = 'cm' + n + '-starter'; }
            FIELDS.forEach(function (k) {
                var el = $('[data-f="' + k + '"]', li);
                var lab = $('[data-for="' + k + '"]', li);
                if (!el) { return; }
                el.id = 'cm' + n + '-' + k;
                if (lab) { lab.setAttribute('for', el.id); }
                if (k === 'lines' && starter) { el.setAttribute('aria-describedby', starter.id); }
                el.value = data[k] == null ? '' : data[k];
                var warn = k === 'name' ? $('[data-warn]', li) : null;
                if (warn) { warn.id = 'cm' + n + '-warn'; el.setAttribute('aria-describedby', warn.id); rosterWarn(el, warn); }
                el.addEventListener('input', function () { data[k] = el.value; saveSoon(); });
                el.addEventListener('change', function () { data[k] = el.value; if (warn) { rosterWarn(el, warn); } save(); });
                el.addEventListener('blur', function () { if (warn) { rosterWarn(el, warn); } save(); });
            });
            list.appendChild(frag);
        });
    }
    render();
    var addBtn = document.getElementById('cm-add');
    if (addBtn) {
        addBtn.addEventListener('click', function () {
            state.blocks.push({});
            save();
            render();
            var last = document.getElementById('cm' + state.blocks.length + '-name');
            if (last) { last.focus(); }
            announce(CM + ' ' + state.blocks.length);
        });
    }

    // ---------- Copy my answers: every block, then the Self-check ----------
    function v(data, k) { return String(data[k] == null ? '' : data[k]).trim(); }
    function buildText() {
        var out = PAGE.title + ' — ' + PAGE.course + ', Week ' + PAGE.week + '\n\n';
        out += lookBlock('back');
        state.blocks.filter(function (data) { return FIELDS.some(function (k) { return v(data, k) !== ''; }); }).forEach(function (data, i) {
            out += CM + ' ' + (i + 1) + '\n';
            out += F.name + ': ' + (v(data, 'name') || '(no name yet)') + '\n';
            out += F.lines + '\n' + (v(data, 'lines') ? indentLines(v(data, 'lines'), '   ') : '   (no answer yet)') + '\n';
            out += F.total + ': ' + (v(data, 'total') || '(no total yet)') + '\n';
            F.qs.forEach(function (q, j) {
                var a = v(data, 'q' + (j + 1));
                out += q + '\n' + (a ? indentLines(a, '   ') : '   (no answer yet)') + '\n';
            });
            out += '\n';
        });
        out += lookBlock('fwd');
        out += scLines();
        return out.replace(/\n+$/, '\n');
    }
    if (copyBtn) { copyBtn.addEventListener('click', function () { doCopy(buildText()); }); }
    if (!storageOK) { showStoreNote(); }
}());
</script>
