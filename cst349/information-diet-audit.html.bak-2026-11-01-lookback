<script>
(function(){var bar=document.getElementById('canvas-bar');if(!bar){return;}var framed=true;try{framed=window.top!==window.self;}catch(e){framed=true;}if(framed||/(^|[?&])context=canvas(&|$)/.test(location.search)){bar.hidden=false;}}());
(function () {
    'use strict';
    // Information Diet Audit — behaviour only. The words students read live in the markup above.
    var PAGE = { page: "cst349-information-diet-audit", course: 'CST349', week: "11", title: "Information Diet Audit" };
    var BOXES = [{"key": "b1", "label": "My sources."}, {"key": "b2", "label": "What I notice."}, {"key": "b3", "label": "My one change."}];
    var KEY = 'cc-gi:' + PAGE.page;
    var TICK_KEY = 'cc-dojo-tick:' + PAGE.page;
    function $(sel, root) { return (root || document).querySelector(sel); }
    function $all(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
    function indentLines(s, pad) { return s.replace(/\r/g, '').split('\n').map(function (l) { return l.trim() ? pad + l : ''; }).join('\n'); }
    var live = document.getElementById('live');

    // ---------- storage ----------
    var storageOK = true;
    var state = { answers: {}, copiedAt: null };
    try {
        var raw = window.localStorage.getItem(KEY);
        if (raw) { var parsed = JSON.parse(raw); if (parsed && typeof parsed === 'object') { state = parsed; } }
    } catch (e) { storageOK = false; }
    if (!state.answers) { state.answers = {}; }
    function showStoreNote() { $all('.storenote').forEach(function (n) { n.style.display = 'block'; }); }
    function save() {
        try { window.localStorage.setItem(KEY, JSON.stringify(state)); storageOK = true; }
        catch (e) { storageOK = false; showStoreNote(); }
    }
    var saveTimer = null;
    function saveSoon() { if (saveTimer) { clearTimeout(saveTimer); } saveTimer = setTimeout(save, 500); }

    // ---------- the Dojo tick: unticked when the page opens (an optional activity), remembered on this browser ----------
    (function () {
        var tick = document.getElementById('dojo-tick');
        if (!tick) { return; }
        function apply(on) {
            document.body.classList.toggle('dojo-on', on);
            tick.setAttribute('aria-expanded', on ? 'true' : 'false');
        }
        var stored = null;
        try { stored = window.localStorage.getItem(TICK_KEY); } catch (e) { stored = null; }
        tick.checked = stored === '1';
        apply(tick.checked);
        tick.addEventListener('change', function () {
            apply(tick.checked);
            try { window.localStorage.setItem(TICK_KEY, tick.checked ? '1' : '0'); } catch (e) { /* not remembered */ }
        });
    }());

    // ---------- clipboard ----------
    function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        ta.style.top = (window.pageYOffset || 0) + 'px';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok ? Promise.resolve() : Promise.reject(new Error('no clipboard'));
    }
    function writeClipboard(text) {
        var nc = null;
        try { nc = navigator.clipboard; } catch (e) { nc = null; }
        if (nc && nc.writeText) {
            try { return nc.writeText(text).catch(function () { return fallbackCopy(text); }); }
            catch (e) { return fallbackCopy(text); }
        }
        return fallbackCopy(text);
    }
    function selectNear(btn) {
        var box = btn.parentNode ? btn.parentNode.querySelector('.ct') : null;
        if (!box || !window.getSelection) { return; }
        try { var r = document.createRange(); r.selectNodeContents(box); var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); } catch (e) { /* nothing more to try */ }
    }
    $all('.copybtn').forEach(function (btn) {
        var label = btn.textContent;
        var timer = null;
        btn.addEventListener('click', function () {
            writeClipboard(btn.getAttribute('data-copy') || '').then(function () {
                btn.textContent = 'Copied';
                btn.classList.add('done');
                if (live) { live.textContent = ''; live.textContent = 'Copied'; }
                if (timer) { clearTimeout(timer); }
                timer = setTimeout(function () {
                    btn.textContent = label;
                    btn.classList.remove('done');
                    if (live) { live.textContent = ''; }
                }, 2000);
            }, function () { selectNear(btn); });
        });
    });

    // ---------- the answer boxes ----------
    $all('textarea[data-key]').forEach(function (ta) {
        var k = ta.getAttribute('data-key');
        ta.value = state.answers[k] || '';
        ta.addEventListener('input', function () { state.answers[k] = ta.value; saveSoon(); });
        ta.addEventListener('blur', save);
    });

    // ---------- Copy my answers: the three boxes under their headings ----------
    function buildText() {
        var out = PAGE.title + ' — ' + PAGE.course + ', Week ' + PAGE.week + '\n\n';
        BOXES.forEach(function (b) {
            var a = String(state.answers[b.key] || '').trim();
            out += b.label + '\n' + (a ? indentLines(a, '   ') : '   (no answer yet)') + '\n\n';
        });
        return out.replace(/\n+$/, '\n');
    }
    var copyBtn = $('#copy-btn'), copyStatus = $('#copy-status'), summaryOut = $('#summary-out');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            var text = buildText();
            summaryOut.value = text;
            state.copiedAt = new Date().toISOString();
            save();
            writeClipboard(text).then(function () {
                copyStatus.className = 'status ok';
                copyStatus.textContent = 'Copied. Paste it into the Canvas text box. The same text is below if you need it again.';
            }, function () {
                copyStatus.className = 'status';
                copyStatus.textContent = 'Copy did not work in this browser. Select the text below and copy it by hand.';
                summaryOut.focus();
                summaryOut.select();
            });
        });
    }
    if (!storageOK) { showStoreNote(); }
}());
</script>
