<script>
(function(){var bar=document.getElementById('canvas-bar');if(!bar){return;}var framed=true;try{framed=window.top!==window.self;}catch(e){framed=true;}if(framed||/(^|[?&])context=canvas(&|$)/.test(location.search)){bar.hidden=false;}}());

(function () {
    'use strict';
    // Sprint 3 graded-item engine: the engine of my-sprint-2-experience-and-sprint-3-path.html and
    // five-real-world-scenarios.html (boxes, AI feedback, AI guidance, Dojo tick, self-check, copy), plus the
    // Sprint 3 frame shared by all four Sprint 3 pages: the path block, the look back and the look forward.
    // Words students read live in the markup; the page's own settings are in CFG.
    var CFG = {
    "page": "cst286-find-and-confirm-my-relationship",
    "course": "CST286",
    "week": "12",
    "title": "Find and confirm my relationship",
    "lookSource": "cst286.s3.1.leave",
    "fillA": false,
    "sys": "You are helping a student check one box of their 'Find and confirm my relationship' form in CST286. Reply in two or three sentences, in plain words: first, what the box already does well, quoting their words; then the one thing that would make it complete and precise, asked as a question or named as what is missing. Use only the criteria for this box, listed below. Never rewrite the student's text, and never supply a formula or numbers. If every criterion is met, say which ones are met and nothing more. Do not use pass/fail language.",
    "meta": {
        "lookback": {
            "coach": "CRITERIA: the Predict line as it stands now, and what changed it if it changed."
        },
        "where": {
            "coach": "CRITERIA: a source by title, link or person, and the part that gave the relationship."
        },
        "relationship": {
            "coach": "CRITERIA: in words and as a formula; every quantity with its unit."
        },
        "condition": {
            "coach": "CRITERIA: a checkable sentence about the physical situation; not a restatement of the formula."
        },
        "before": {
            "coach": "CRITERIA: the setup and a predicted number with its unit, written before the check."
        },
        "did": {
            "coach": "CRITERIA: what was run or measured."
        },
        "got": {
            "coach": "CRITERIA: the result of the check, with its unit."
        },
        "makeof": {
            "coach": "CRITERIA: the two numbers compared, and a possible cause of any difference tied to the condition or a measurement."
        },
        "leave": {
            "coach": "CRITERIA: the relationship and condition, and a first situation to try."
        }
    }
};
    var PAGE = { page: CFG.page, course: CFG.course, week: CFG.week, title: CFG.title };
    var KEY = 'cc-gi:' + PAGE.page;
    var TICK_KEY = 'cc-dojo-tick:' + PAGE.page;
    var PATH_KEY = 'cst286.s3.path';
    // The 30 Oct page (my-sprint-2-experience-and-sprint-3-path.html) saves its state under 'cc-gi:' + its PAGE.page.
    var OCT30_KEYS = ['cc-gi:cst286-my-sprint-2-experience-and-sprint-3-path', 'cc-gi:my-sprint-2-experience-and-sprint-3-path'];
    var AI_ENDPOINT = 'https://ai-assisted-pedagogy.netlify.app/.netlify/functions/ai-proxy';

    function $(sel, root) { return (root || document).querySelector(sel); }
    function $all(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
    function indentLines(s, pad) { return s.replace(/\r/g, '').split('\n').map(function (l) { return l.trim() ? pad + l : ''; }).join('\n'); }
    function clean(s) { return String(s || '').replace(/\s+/g, ' ').trim(); }
    function lsGet(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } }
    function lsSet(k, v) {
        try { if (v === null) { window.localStorage.removeItem(k); } else { window.localStorage.setItem(k, v); } return true; }
        catch (e) { return false; }
    }
    var live = document.getElementById('live');

    // ---------- storage ----------
    var storageOK = true;
    var state = { answers: {}, checks: {}, guides: {}, copiedAt: null };
    try {
        var raw = window.localStorage.getItem(KEY);
        if (raw) { var parsed = JSON.parse(raw); if (parsed && typeof parsed === 'object') { state = parsed; } }
    } catch (e) { storageOK = false; }
    if (!state.answers) { state.answers = {}; }
    if (!state.checks) { state.checks = {}; }
    if (!state.guides) { state.guides = {}; }
    function showStoreNote() { $all('.storenote').forEach(function (n) { n.style.display = 'block'; }); }
    function save() {
        try { window.localStorage.setItem(KEY, JSON.stringify(state)); storageOK = true; }
        catch (e) { storageOK = false; showStoreNote(); }
    }
    var saveTimer = null;
    function saveSoon() { if (saveTimer) { clearTimeout(saveTimer); } saveTimer = setTimeout(save, 500); }
    function answerState(key) {
        if (!state.answers[key]) { state.answers[key] = { text: '', ai: [] }; }
        if (!state.answers[key].ai) { state.answers[key].ai = []; }
        return state.answers[key];
    }

    // ---------- the 30 October answers on this browser ----------
    function read30Oct() {
        for (var i = 0; i < OCT30_KEYS.length; i++) {
            try {
                var r = window.localStorage.getItem(OCT30_KEYS[i]);
                if (!r) { continue; }
                var p = JSON.parse(r);
                if (p && p.answers) {
                    return {
                        path: p.answers.path ? String(p.answers.path.text || '') : '',
                        why: p.answers.why ? String(p.answers.why.text || '') : ''
                    };
                }
            } catch (e) { /* unreadable: treat as absent */ }
        }
        return { path: '', why: '' };
    }
    var oct30 = read30Oct();

    // ---------- the path block: pre-selected from this browser, or the rest of the page waits for a choice ----------
    function pathRadios() { return $all('input[type="radio"][name="s3path"]'); }
    function currentPath() {
        var on = pathRadios().filter(function (r) { return r.checked; })[0];
        return on ? on.value : '';
    }
    function pathTitle() {
        var on = pathRadios().filter(function (r) { return r.checked; })[0];
        return on ? on.getAttribute('data-title') : '';
    }
    var pathListeners = [];
    function applyPath() {
        var p = currentPath();
        $all('[data-path]').forEach(function (el) {
            el.hidden = !p || el.getAttribute('data-path').split(/\s+/).indexOf(p) < 0;
        });
        var gated = document.getElementById('gated');
        if (gated) { gated.hidden = !p; }
        pathListeners.forEach(function (fn) { fn(p); });
    }
    (function () {
        var found = '';
        var s3 = lsGet(PATH_KEY);
        if (s3 === 'A' || s3 === 'B' || s3 === 'C') { found = s3; }
        else if (oct30.path === 'A' || oct30.path === 'B' || oct30.path === 'C') { found = oct30.path; }
        var note = document.getElementById('path-note');
        if (note) {
            note.textContent = found ? note.getAttribute('data-found') : note.getAttribute('data-none');
            note.classList.toggle('need', !found);
        }
        pathRadios().forEach(function (r) {
            r.checked = r.value === found;
            r.addEventListener('change', function () {
                if (!r.checked) { return; }
                answerState('path').text = r.value;
                save();
                lsSet(PATH_KEY, r.value);
                applyPath();
            });
        });
        if (found) { answerState('path').text = found; }
        applyPath();
    }());

    // ---------- the look back: the sentence this student wrote before, when this browser has it ----------
    (function () {
        var foundEl = document.getElementById('look-found');
        var noneEl = document.getElementById('look-none');
        if (!foundEl || !noneEl || !CFG.lookSource) { return; }
        var prev = '';
        if (CFG.lookSource === 'oct30why') { prev = oct30.why; }
        else { prev = lsGet(CFG.lookSource) || ''; }
        prev = prev.trim();
        if (prev) {
            document.getElementById('look-text').textContent = prev;
            foundEl.hidden = false;
            noneEl.hidden = true;
        } else {
            foundEl.hidden = true;
            noneEl.hidden = false;
        }
    }());

    // ---------- the Dojo tick ----------
    (function () {
        var tick = document.getElementById('dojo-tick');
        if (!tick) { return; }
        function apply(on) {
            document.body.classList.toggle('dojo-on', on);
            tick.setAttribute('aria-expanded', on ? 'true' : 'false');
        }
        var stored = lsGet(TICK_KEY);
        tick.checked = stored !== '0';
        apply(tick.checked);
        tick.addEventListener('change', function () {
            apply(tick.checked);
            lsSet(TICK_KEY, tick.checked ? '1' : '0');
        });
    }());

    // ---------- copy buttons on the Dojo prompts ----------
    function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        ta.style.top = (window.pageYOffset || 0) + 'px';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok ? Promise.resolve() : Promise.reject(new Error('no clipboard'));
    }
    function writeClipboard(text) {
        var nc = null;
        try { nc = navigator.clipboard; } catch (e) { nc = null; }
        if (nc && nc.writeText) {
            try { return nc.writeText(text).catch(function () { return fallbackCopy(text); }); }
            catch (e) { return fallbackCopy(text); }
        }
        return fallbackCopy(text);
    }
    function selectNear(btn) {
        var box = btn.parentNode ? btn.parentNode.querySelector('.ct') : null;
        if (!box || !window.getSelection) { return; }
        try { var r = document.createRange(); r.selectNodeContents(box); var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); } catch (e) { /* nothing more to try */ }
    }
    $all('.copybtn').forEach(function (btn) {
        var label = btn.textContent;
        var timer = null;
        btn.addEventListener('click', function () {
            writeClipboard(btn.getAttribute('data-copy') || '').then(function () {
                btn.textContent = 'Copied';
                btn.classList.add('done');
                if (live) { live.textContent = ''; live.textContent = 'Copied'; }
                if (timer) { clearTimeout(timer); }
                timer = setTimeout(function () {
                    btn.textContent = label;
                    btn.classList.remove('done');
                    if (live) { live.textContent = ''; }
                }, 2000);
            }, function () { selectNear(btn); });
        });
    });

    // ---------- choice radios (look back, look forward, exam steps): remembered on this browser ----------
    function choiceValue(name) {
        var on = $('input[type="radio"][name="' + name + '"]:checked');
        return on ? on.value : '';
    }
    $all('fieldset.choice[data-name]').forEach(function (fs) {
        var name = fs.getAttribute('data-name');
        var st = answerState(name);
        $all('input[type="radio"]', fs).forEach(function (r) {
            r.checked = !!st.text && st.text === r.value;
            r.addEventListener('change', function () { if (r.checked) { st.text = r.value; save(); } });
        });
    });

    // ---------- AI feedback on what is written in each box ----------
    var META = CFG.meta || {};
    function showAi(el, text, n, prefix) {
        el.style.display = 'block';
        el.innerHTML = '';
        var lbl = document.createElement('span');
        lbl.className = 'lbl';
        var base = prefix || 'AI feedback';
        lbl.textContent = n > 1 ? (base + ' · round ' + n) : base;
        el.appendChild(lbl);
        el.appendChild(document.createTextNode(text));
    }
    function boxLabel(key) { var l = $('label[for="bx-' + key + '"]'); return l ? clean(l.textContent) : key; }
    function questionFor(key) {
        var q = document.getElementById('q-' + key);
        var st = document.getElementById('st-' + key);
        return (q ? clean(q.textContent) + ' ' : '') + 'Box: ' + boxLabel(key) + (st ? ' ' + clean(st.textContent) : '');
    }
    function otherLines(key) {
        var s = '- Your path for Sprint 3: ' + (pathTitle() || '(not chosen yet)') + '\n';
        $all('fieldset.choice[data-name]').forEach(function (fs) {
            s += '- ' + fs.getAttribute('data-cp-label') + ' ' + (choiceValue(fs.getAttribute('data-name')) || '(not chosen yet)') + '\n';
        });
        $all('textarea[data-key]').forEach(function (ta) {
            var k = ta.getAttribute('data-key');
            if (k === key) { return; }
            var val = clean(ta.value);
            if (!val && /^s\d_/.test(k)) { return; }
            s += '- ' + boxLabel(k) + ' ' + (val || '(empty)') + '\n';
        });
        return s;
    }
    function askAi(key, ta, btn, box, refresh) {
        var meta = META[key];
        if (!meta) { return; }
        var st = answerState(key);
        var text = ta.value.trim();
        var content = 'PAGE: ' + PAGE.title + ' (' + PAGE.course + ', Week ' + PAGE.week + ', graded item)\n' +
            'THE BOX THEY ARE WRITING: ' + questionFor(key) + '\n\n' +
            'WHAT THEY WROTE:\n"""' + text + '"""\n\n' +
            'OTHER BOXES FILLED SO FAR (context only; give feedback on the box above):\n' + otherLines(key) + '\n' +
            'COACH NOTES (ground truth for you, not to be quoted back wholesale):\n' + meta.coach;
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Reading what you wrote...';
        box.style.display = 'block';
        box.innerHTML = '<span class="lbl">AI feedback</span>Reading what you wrote...';
        fetch(AI_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ system: CFG.sys, messages: [{ role: 'user', content: content }], max_tokens: 320 })
        }).then(function (r) {
            if (!r.ok) { throw new Error('status ' + r.status); }
            return r.json();
        }).then(function (data) {
            var reply = String(data.content || data.text || '').trim();
            if (!reply) { throw new Error('empty'); }
            st.ai.push({ at: new Date().toISOString(), onText: text, text: reply });
            save();
            showAi(box, reply, st.ai.length, 'AI feedback');
        }).catch(function () {
            box.style.display = 'block';
            box.innerHTML = '<span class="lbl">AI feedback</span><span class="err">Could not get feedback right now. Your answer is saved; try the button again later.</span>';
        }).then(function () { btn.textContent = label; refresh(); });
    }

    // ---------- the look forward sentence, also saved for the course home page and the next item ----------
    var leaveTimers = {};
    function saveLeave(ta) {
        var k = ta.getAttribute('data-leave');
        if (!k) { return; }
        var v = ta.value;
        lsSet(k, v.trim() ? v : null);
    }
    function saveLeaveSoon(ta) {
        var k = ta.getAttribute('data-leave');
        if (leaveTimers[k]) { clearTimeout(leaveTimers[k]); }
        leaveTimers[k] = setTimeout(function () { saveLeave(ta); }, 400);
    }

    var refreshers = {};
    $all('textarea[data-key]').forEach(function (ta) {
        var key = ta.getAttribute('data-key');
        var st = answerState(key);
        if (!st.text && ta.getAttribute('data-leave')) { st.text = lsGet(ta.getAttribute('data-leave')) || ''; }
        ta.value = st.text || '';
        var btn = $('[data-ai="' + key + '"]');
        var box = $('[data-aibox="' + key + '"]');
        if (st.ai.length && box) { showAi(box, st.ai[st.ai.length - 1].text, st.ai.length, 'AI feedback'); }
        function refresh() {
            if (!btn) { return; }
            var t = ta.value.trim();
            var last = st.ai.length ? st.ai[st.ai.length - 1].onText : null;
            btn.disabled = t.length === 0 || t === last;
        }
        refreshers[key] = refresh;
        ta.addEventListener('input', function () {
            st.text = ta.value;
            if (key === 'condition') { updateConditionEcho(); }
            if (ta.getAttribute('data-leave')) { saveLeaveSoon(ta); }
            refresh();
            saveSoon();
        });
        ta.addEventListener('blur', function () { save(); if (ta.getAttribute('data-leave')) { saveLeave(ta); } });
        if (btn && box) { btn.addEventListener('click', function () { askAi(key, ta, btn, box, refresh); }); }
        refresh();
    });
    window.addEventListener('pagehide', function () {
        save();
        $all('textarea[data-leave]').forEach(saveLeave);
    });

    // ---------- Path A: Parts 1 and 2 open with Example A when their boxes are empty ----------
    (function () {
        if (!CFG.fillA) { return; }
        var EXA = {};
        $all('#ex-a dd[data-fill]').forEach(function (dd) { EXA[dd.getAttribute('data-fill')] = clean(dd.textContent); });
        function fillFromExampleA() {
            var changed = false;
            Object.keys(EXA).forEach(function (key) {
                var ta = document.getElementById('bx-' + key);
                if (!ta || ta.value.trim()) { return; }
                ta.value = EXA[key];
                answerState(key).text = ta.value;
                if (refreshers[key]) { refreshers[key](); }
                changed = true;
            });
            if (changed) { save(); }
        }
        pathListeners.push(function (p) { if (p === 'A') { fillFromExampleA(); } });
        if (currentPath() === 'A') { fillFromExampleA(); }
    }());

    // ---------- live echo of the Part 1 condition at the top of Scenarios 4 and 5 ----------
    function updateConditionEcho() {
        var condTa = document.getElementById('bx-condition');
        var val = condTa ? condTa.value.trim() : '';
        $all('[data-cond-echo]').forEach(function (el) {
            if (val) {
                el.textContent = val;
                el.classList.remove('ce-empty');
            } else {
                el.textContent = '(Write your condition in Part 1 above — it will appear here so you can point to the exact part that breaks.)';
                el.classList.add('ce-empty');
            }
        });
    }
    updateConditionEcho();

    // ---------- AI guidance buttons above each Scenario block (1-5) ----------
    var SYS_GUIDE = "You are a Socratic physics coach in CST286 helping a student brainstorm their own real-world scenario for the 'Five real-world scenarios' form. Never invent or write a complete scenario for the student, and never supply the numbers or work the calculation for them. Reply in 2 to 4 short sentences: briefly acknowledge their formula and condition from Part 1, then ask 2 or 3 concrete guiding questions that point their attention to everyday objects, sports, vehicles, devices, or physical changes so they can come up with the scenario themselves.";
    function askScenarioGuide(num, btn, box) {
        var rel = clean((document.getElementById('bx-relationship') || {}).value);
        var cond = clean((document.getElementById('bx-condition') || {}).value);
        if (!rel && !cond) {
            box.style.display = 'block';
            box.innerHTML = '<span class="lbl">AI guidance · Scenario ' + num + '</span>Write your quantitative relationship (math formula) and your physical condition in Part 1 first, then press this button so the guiding questions fit your exact formula and condition.';
            return;
        }
        var isApply = num <= 3;
        var summary = 'PART 1:\n- Relationship: ' + (rel || '(not yet written)') + '\n- Condition: ' + (cond || '(not yet written)') + '\n\nSCENARIOS DRAFTED SO FAR:\n';
        [1, 2, 3, 4, 5].forEach(function (i) {
            var sit = clean((document.getElementById('bx-s' + i + '_situation') || {}).value);
            if (sit) { summary += '- Scenario ' + i + ' situation: ' + sit + '\n'; }
        });
        var taskInstructions = isApply
            ? ('The student is working on Scenario ' + num + ' (one of the three scenarios where their Part 1 formula and condition APPLY). Ask 2 or 3 guiding questions to help them think of a concrete, everyday situation — distinct from any scenarios they already drafted above — where their condition holds and where they can estimate realistic starting numbers.')
            : ('The student is working on Scenario ' + num + ' (one of the two look-alike scenarios where the setup looks similar on the surface to one of their Part 2 scenarios, but the formula is NOT applicable because their Part 1 condition is broken). Ask 2 or 3 guiding questions that help them pick one of their Part 2 scenarios and identify one physical detail about the object or its surroundings (such as friction, air resistance, incline, shape, or an extra force/factor) they could change so that someone might still try to use the formula, but the Part 1 condition no longer holds.');
        if (CFG.guideNote) { taskInstructions += ' ' + CFG.guideNote; }
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Thinking of guiding questions...';
        box.style.display = 'block';
        box.innerHTML = '<span class="lbl">AI guidance · Scenario ' + num + '</span>Thinking of guiding questions...';
        fetch(AI_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                system: SYS_GUIDE,
                messages: [{ role: 'user', content: summary + '\nYOUR TASK:\n' + taskInstructions }],
                max_tokens: 320
            })
        }).then(function (r) {
            if (!r.ok) { throw new Error('status ' + r.status); }
            return r.json();
        }).then(function (data) {
            var reply = String(data.content || data.text || '').trim();
            if (!reply) { throw new Error('empty'); }
            if (!state.guides[num]) { state.guides[num] = []; }
            state.guides[num].push({ at: new Date().toISOString(), text: reply });
            save();
            showAi(box, reply, state.guides[num].length, 'AI guidance · Scenario ' + num);
        }).catch(function () {
            box.style.display = 'block';
            box.innerHTML = '<span class="lbl">AI guidance · Scenario ' + num + '</span><span class="err">Could not get guidance right now. Try the button again in a moment.</span>';
        }).then(function () {
            btn.disabled = false;
            btn.textContent = label;
        });
    }
    $all('button[data-guide]').forEach(function (btn) {
        var num = parseInt(btn.getAttribute('data-guide'), 10);
        var box = $('[data-guidebox="' + num + '"]');
        if (state.guides[num] && state.guides[num].length && box) {
            showAi(box, state.guides[num][state.guides[num].length - 1].text, state.guides[num].length, 'AI guidance · Scenario ' + num);
        }
        if (box) { btn.addEventListener('click', function () { askScenarioGuide(num, btn, box); }); }
    });

    // ---------- Copy my answers: path, look back, every box, look forward, self-check, in page order ----------
    function txt(key) { return (answerState(key).text || '').trim(); }
    function block(label, a) { return label + '\n' + (a ? indentLines(a, '   ') : '   (no answer yet)') + '\n\n'; }
    function buildText() {
        var out = PAGE.title + ' — ' + PAGE.course + ', Week ' + PAGE.week + '\n\n';
        var tick = document.getElementById('dojo-tick');
        var tickLabel = $('label[for="dojo-tick"] b');
        out += (tick && tick.checked ? '[x] ' : '[ ] ') + (tickLabel ? clean(tickLabel.textContent) : '') + '\n\n';
        $all('[data-cp]').forEach(function (el) {
            var kind = el.getAttribute('data-cp');
            if (kind === 'head') { out += clean(el.textContent).toUpperCase() + '\n\n'; }
            else if (kind === 'path') { out += block(el.getAttribute('data-cp-label'), pathTitle()); }
            else if (kind === 'radio') { out += block(el.getAttribute('data-cp-label'), choiceValue(el.getAttribute('data-name'))); }
            else if (kind === 'box') { var k = el.getAttribute('data-key'); out += block(boxLabel(k), txt(k)); }
        });
        out += 'SELF-CHECK (ticked by me; the grader verifies each line)\n';
        var total = 0;
        $all('ul.selfcheck li').forEach(function (li) {
            var cb = $('input[data-check]', li), on = cb && cb.checked;
            var pts = parseInt(($('.pts', li).textContent.match(/\d+/) || ['0'])[0], 10);
            if (on) { total += pts; }
            out += (on ? '[x] ' : '[ ] ') + clean($('label', li).textContent) + ' · ' + pts + ' pts\n';
        });
        out += 'Self-check total: ' + total + ' of 100\n';
        return out.replace(/\n+$/, '\n');
    }

    // ---------- Self-check ticks ----------
    function scTotal() {
        var t = 0;
        $all('ul.selfcheck li').forEach(function (li) {
            var cb = $('input[data-check]', li);
            if (cb && cb.checked) { t += parseInt(($('.pts', li).textContent.match(/\d+/) || ['0'])[0], 10); }
        });
        var el = $('#sc-total');
        if (el) { el.textContent = t + ' of 100 points ticked'; }
    }
    $all('input[data-check]').forEach(function (cb) {
        var id = cb.getAttribute('data-check');
        cb.checked = !!state.checks[id];
        cb.addEventListener('change', function () { state.checks[id] = cb.checked; save(); scTotal(); });
    });
    scTotal();

    var copyBtn = $('#copy-btn'), copyStatus = $('#copy-status'), summaryOut = $('#summary-out');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            var text = buildText();
            summaryOut.value = text;
            state.copiedAt = new Date().toISOString();
            save();
            writeClipboard(text).then(function () {
                copyStatus.className = 'status ok';
                copyStatus.textContent = 'Copied. Paste it into the Canvas text box. The same text is below if you need it again.';
            }, function () {
                copyStatus.className = 'status';
                copyStatus.textContent = 'Copy did not work in this browser. Select the text below and copy it by hand.';
                summaryOut.focus();
                summaryOut.select();
            });
        });
    }
    if (!storageOK) { showStoreNote(); }
}());
</script>
<script id="a11y-pass-1-js">
(function () {
  // Escape closes an open glossary bubble (hover or focus); it comes back on the next hover or focus.
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.gl:hover, .gl:focus-within').forEach(function (g) {
      g.classList.add('a11y-esc');
      function clear() { g.classList.remove('a11y-esc'); g.removeEventListener('mouseleave', clear); g.removeEventListener('focusout', clear); }
      g.addEventListener('mouseleave', clear); g.addEventListener('focusout', clear);
    });
  });
})();
</script>
