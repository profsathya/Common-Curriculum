<style id="sprint3-frame">
  /* ---------- Sprint 3 frame (29 Oct 2026): purpose chain, path block, look back, look forward ---------- */
  /* the three-box arrow chain (from what-are-my-priorities.html) */
  .thread-flow{display:grid;grid-template-columns:1fr auto 1.15fr auto 1fr;align-items:stretch;gap:10px;margin-bottom:22px;max-width:1000px}
  .tbox{background:var(--card);border:1.5px solid var(--line);border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;justify-content:flex-start;font-size:15px;line-height:1.5;color:var(--ink)}
  .tbox .tlbl{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:4px;font-family:"IBM Plex Mono",monospace}
  .tbox.now{background:var(--tsoft);border:2px solid var(--tc);box-shadow:0 2px 8px rgba(3,116,181,.08)}
  .tbox.now .tlbl{color:var(--tc)}
  .tbox p{margin:0}
  .tbox a{font-weight:700}
  .tarrow{display:flex;align-items:center;justify-content:center;color:var(--tc);padding:0 2px}
  .tarrow svg{width:28px;height:28px;stroke:currentColor;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
  /* stacks at the Canvas embed width (754px) and below */
  @media (max-width:820px){
    .thread-flow{grid-template-columns:1fr;gap:6px}
    .tarrow svg{transform:rotate(90deg);width:22px;height:22px}
  }

  /* the path block (option cards from my-sprint-2-goal-and-plan.html) */
  fieldset.pathpick{border:0; margin:0; padding:0; min-width:0}
  .opts{display:grid; gap:12px; max-width:900px}
  @media (min-width:900px){ .opts.short{grid-template-columns:repeat(3,minmax(0,1fr))} }
  label.opt{display:flex; gap:14px; align-items:flex-start; background:var(--card); border:1.5px solid var(--line); border-radius:6px; padding:16px 18px; cursor:pointer; line-height:1.55}
  label.opt input{flex:0 0 24px; width:24px; height:24px; margin:2px 0 0; accent-color:var(--tc); cursor:pointer}
  label.opt:has(input:checked){border:2px solid var(--tc); background:var(--tsoft)}
  label.opt input:focus-visible{outline:3px solid var(--blaze); outline-offset:2px}
  .pathnote{margin:0 0 12px; max-width:900px; padding:10px 14px; border-radius:5px; background:var(--card); border:1px solid var(--line); border-left:5px solid var(--teal); font-weight:700}
