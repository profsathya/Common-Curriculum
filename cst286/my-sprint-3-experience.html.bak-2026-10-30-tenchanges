<!-- my-sprint-3-experience.md in this folder is the editable companion to this page: the words are edited there and carried into this file. The chrome and engine (boxes, AI feedback, Dojo tick, self-check, copy) follow my-sprint-2-experience-and-sprint-3-path.html; the purpose chain is the one on what-are-my-priorities.html. The Sprint 3 frame (path block, look back, look forward) is the same on all four Sprint 3 pages: my-sprint-3-goal-and-plan.html, find-and-confirm-my-relationship.html, five-real-world-scenarios-sprint-3.html, my-sprint-3-experience.html. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --blue:#0374B5; --blue-dark:#0a5a8a; --text:#2D3B45; --muted:#5C6873;
    --border:#C7CDD1; --border-light:#E8EAEC; --teal:#0F766E;
    --font:"Lato","Helvetica Neue",Helvetica,Arial,sans-serif;
    --paper:#F4F3EC; --card:#FCFBF6; --ink:#22303C; --ink-soft:#5C6B74;
    --line:#DAD6C7; --line-soft:#E7E4D8;
    --blaze:#B04A18; --hero-ink:#131F2B; --hero-cream:#EFE9D6;
    --warn:#6F5612; --vista:#B08018;
    --t-phone:#2F6BA8; --t-phone-soft:#E2EAF3;
    --tc:var(--t-phone); --tsoft:var(--t-phone-soft);
    --on-tc:#FFFFFF;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#141C24; --card:#1B242E; --ink:#E8E4D6; --ink-soft:#9FABB2;
      --line:#31404C; --line-soft:#26333E;
      --blaze:#E0793C; --blue:#6BAEDC; --blue-dark:#9CCBEA; --teal:#5FC9BE; --warn:#D6B04A; --vista:#D9AE3E;
      --t-phone:#7FA9D6; --t-phone-soft:#22313F; --on-tc:#131F2B;
    }
  }
  :root[data-theme="dark"]{
    --paper:#141C24; --card:#1B242E; --ink:#E8E4D6; --ink-soft:#9FABB2;
    --line:#31404C; --line-soft:#26333E;
    --blaze:#E0793C; --blue:#6BAEDC; --blue-dark:#9CCBEA; --teal:#5FC9BE; --warn:#D6B04A; --vista:#D9AE3E;
    --t-phone:#7FA9D6; --t-phone-soft:#22313F; --on-tc:#131F2B;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:"Atkinson Hyperlegible",var(--font); color:var(--ink); background:var(--paper); font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased; overflow-wrap:break-word}
  .page{max-width:1180px; margin:0 auto; padding:22px 22px 56px}
  h1,h2,h3,h4{font-family:Fraunces,Georgia,serif; text-wrap:balance; margin:0}
  a{color:var(--blaze)}
  p{margin:0 0 12px}
  a:focus-visible,button:focus-visible,summary:focus-visible,iframe:focus-visible{outline:3px solid var(--blaze); outline-offset:2px; border-radius:3px}
  .mono,.num,code{font-family:"IBM Plex Mono",monospace}

  .canvasbar{display:flex;flex-wrap:wrap;gap:5px 10px;align-items:baseline;border:1px solid var(--line);border-left:4px solid var(--tc);background:var(--tsoft);color:var(--ink);border-radius:5px;padding:9px 13px;margin:0 0 14px;font-size:14px}
  .canvasbar[hidden]{display:none}
  .canvasbar a{color:var(--blue-dark)}

  .crumb{font-family:"IBM Plex Mono",monospace; font-size:.8rem; letter-spacing:.06em; margin-bottom:12px}
  .crumb a{color:var(--ink-soft); text-decoration:none}
  .crumb a::before{content:"\2190\00a0"}
  .crumb a:hover{color:var(--blaze); text-decoration:underline}

  /* hero */
  .hero{background:var(--hero-ink); color:var(--hero-cream); border-radius:8px; position:relative; overflow:hidden}
  .hero-inner{padding:38px 34px 34px; position:relative; z-index:1}
  .hero .kicker{font-family:"IBM Plex Mono",monospace; font-size:.75rem; letter-spacing:.16em; text-transform:uppercase; color:#9FB2C4; margin:0 0 14px}
  .hero h1{font-size:clamp(1.85rem,4.6vw,2.85rem); font-weight:900; line-height:1.08; letter-spacing:-.01em; color:var(--hero-cream)}
  .hero .intro{font-size:1.08rem; color:#DCE3E8; margin:18px 0 0; max-width:62ch; border-left:3px solid var(--blaze); padding:4px 0 4px 16px}

  /* buttons */
  button{font:inherit}
  .copybtn,.stepbtn,.simbtn{font-family:"Atkinson Hyperlegible",var(--font); font-size:.9rem; font-weight:700; padding:8px 14px; min-height:40px; border-radius:5px; cursor:pointer; border:1.5px solid var(--tc); color:var(--on-tc); background:var(--tc)}
  .copybtn::before{content:"\29C9\00a0\00a0"}
  .copybtn.done::before{content:"\2713\00a0\00a0"}
  .stepbtn.alt,.prompt .copybtn{background:transparent; color:var(--tc)}
  .copybtn:hover,.stepbtn:hover,.simbtn:hover{filter:brightness(1.1)}

  /* dojo prompts */
  .prompt{display:flex; flex-wrap:wrap; align-items:flex-start; gap:10px 14px; background:var(--paper); border:1px solid var(--line); border-left:3px solid var(--teal); border-radius:5px; padding:12px 14px; margin:0 0 10px; max-width:820px}
  .prompt .ptext{flex:1 1 320px; margin:0; font-family:"IBM Plex Mono",monospace; font-size:.86rem; line-height:1.55; max-width:none}
  .prompt .copybtn{flex:0 0 auto}

  /* provenance */
  .prov2{margin-top:30px; border:1px solid var(--line); border-radius:6px; background:var(--card); padding:0; font-size:.88rem; color:var(--ink)}
  .prov2 .prov-head{padding:12px 16px 0; font-family:"Atkinson Hyperlegible",var(--font); font-size:.95rem; font-weight:700}
  .prov2 .prov-lead{padding:5px 16px 14px; margin:0; line-height:1.55; max-width:none}
  .pagenav{margin-top:20px; padding-top:14px; border-top:1px solid var(--line); font-size:.9rem}
  .pagenav a{color:var(--blue-dark)}
  .pagenav a::before{content:"\2190\00a0"}
  .sr{position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap}

  [hidden]{display:none !important}
  body:not(.dojo-on) .dojo-only{display:none !important}
  body.dojo-on .airow{display:none !important}

  .gibar{margin:14px 0 0; border:1px solid var(--line); border-left:5px solid var(--blaze); background:var(--card); border-radius:5px; padding:11px 16px; font-size:.95rem}
  .gibar b{font-family:"IBM Plex Mono",monospace; font-size:.86rem; letter-spacing:.02em}
  h2.sec{font-size:1.5rem; font-weight:650; margin:38px 0 12px; padding-bottom:7px; border-bottom:2px solid var(--line)}
  h2.sec.minor{font-size:1.2rem; margin-top:30px}
  .body{max-width:74ch}
  .choose{display:flex; gap:12px; align-items:flex-start; background:var(--card); border:1px solid var(--line); border-left:5px solid var(--teal); border-radius:5px; padding:14px 16px; margin-top:16px; max-width:900px}
  .choose input{flex:0 0 24px; width:24px; height:24px; margin:2px 0 0; accent-color:var(--tc); cursor:pointer}
  .choose label{cursor:pointer}
  .choose input:focus-visible{outline:3px solid var(--blaze); outline-offset:2px}
  .dojowarn{margin:12px 0 0; max-width:900px; background:#FFF1B8; border:2px solid #B87A00; color:#2E2100; border-radius:6px; padding:12px 16px; font-weight:700}
  #dojo-block{margin-top:6px; max-width:900px}
  .passcode{font-family:"IBM Plex Mono",monospace; font-size:1.05rem; background:var(--card); border:1.5px dashed var(--tc); border-radius:5px; padding:9px 14px; display:inline-block; margin:0 0 14px}
  .dsteps{padding-left:24px; margin:0}
  .dsteps > li{margin:0 0 16px; padding-left:4px}
  .dsteps > li::marker{font-family:"IBM Plex Mono",monospace; font-weight:600; color:var(--tc)}

  .formgrid{display:grid; gap:24px; margin-top:4px}
  @media (min-width:900px){ .formgrid{grid-template-columns:minmax(0,2fr) minmax(0,1fr); align-items:start} }
  .formcol > h3{font-size:1.22rem; font-weight:650; margin:28px 0 8px}
  .formcol > h3:first-child{margin-top:4px}
  .formcol .task{margin:0}
  .formcol .tasks{list-style:none; margin:0; padding:0; display:grid; gap:12px}
  .task{background:var(--card); border:1px solid var(--line); border-radius:5px; padding:14px 16px 12px}
  .task .ttext{display:flex; gap:10px; margin:0 0 10px}
  .task .tn{flex:0 0 24px; font-family:"IBM Plex Mono",monospace; font-weight:600; color:var(--tc)}
  .task .tt{flex:1; min-width:0; max-width:74ch}
  .tlist{margin:4px 0 0; padding-left:20px}
  .tlist li{margin:0 0 4px}
  .rbox{margin:8px 0 0}
  label.qt{display:block; font-size:.92rem; margin:0 0 4px; color:var(--ink)}
  textarea.box{display:block; width:100%; min-height:110px; font:inherit; font-size:.97rem; line-height:1.5; color:var(--ink); background:var(--paper); border:1px solid var(--line); border-radius:5px; padding:10px 12px; resize:vertical}
  textarea.box.small{min-height:80px}
  textarea.box:focus-visible{outline:3px solid var(--blaze); outline-offset:1px}
  .btn{font:inherit; font-size:.9rem; font-weight:700; padding:8px 14px; border-radius:5px; cursor:pointer; border:1.5px solid var(--tc); color:var(--tc); background:var(--card)}
  .btn.primary{background:var(--tc); color:var(--on-tc)}
  .btn.guidebtn{border-color:var(--teal); color:var(--teal); background:var(--paper)}
  .btn[disabled]{opacity:.45; cursor:not-allowed}
  .airow{margin:8px 0 0}
  .guiderow{margin:0 0 12px; display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px}
  .guiderow .ghint{font-size:.85rem; color:var(--ink-soft)}
  .aibox{display:none; margin:9px 0 0; padding:12px 14px; background:var(--tsoft); border:1px solid var(--line); border-radius:6px; font-size:.93rem; line-height:1.55; white-space:pre-wrap; max-width:74ch}
  .aibox.guidebox{margin:0 0 14px; border-left:4px solid var(--teal)}
  .aibox .lbl{display:block; font-family:"IBM Plex Mono",monospace; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; color:var(--tc); font-weight:600; margin-bottom:4px}
  .aibox.guidebox .lbl{color:var(--teal)}
  .aibox .err{color:var(--blaze)}

  /* scenario cards */
  .scenblock{margin:16px 0 0; padding:16px 16px 14px; background:var(--card); border:1.5px solid var(--line); border-left:5px solid var(--tc); border-radius:6px}
  .scenblock.nonapp{border-left-color:var(--blaze)}
  .scenblock > h4{font-size:1.08rem; font-weight:650; margin:0 0 10px; color:var(--ink); display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:6px}
  .scenblock > h4 .stag{font-family:"IBM Plex Mono",monospace; font-size:.75rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--tc)}
  .scenblock.nonapp > h4 .stag{color:var(--blaze)}
  .scenblock .task{background:var(--paper); padding:12px 14px 10px}
  .cond-echo{margin:0 0 12px; padding:10px 13px; background:var(--tsoft); border:1px solid var(--line); border-left:4px solid var(--blaze); border-radius:5px; font-size:.92rem; line-height:1.5}
  .cond-echo b{font-family:"IBM Plex Mono",monospace; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; color:var(--blaze); display:block; margin-bottom:2px}
  .cond-echo .ce-empty{font-style:italic; color:var(--ink-soft)}

  /* worked examples column */
  .examples h2.sec{margin-top:4px; font-size:1.2rem}
  .examples > p{font-size:.93rem; color:var(--ink-soft)}
  .excard{background:var(--card); border:1px solid var(--line); border-left:4px solid var(--tc); border-radius:5px; padding:12px 14px 8px; margin:0 0 14px; font-size:.92rem; line-height:1.5}
  .excard h3{font-size:1rem; font-weight:650; margin:0 0 8px}
  .excard .exsub{font-family:"IBM Plex Mono",monospace; font-size:.75rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--tc); margin:10px 0 4px; padding-top:8px; border-top:1px dashed var(--line)}
  .excard .exsub.nonapp{color:var(--blaze)}
  .excard dl{margin:0}
  .excard dt{font-style:italic; font-weight:700; color:var(--ink-soft); font-size:.85rem}
  .excard dd{margin:0 0 7px}

  ul.selfcheck{list-style:none;margin:0 0 4px;padding:0;font-size:14px}
  ul.selfcheck li{display:flex;gap:9px;align-items:flex-start;margin:0 0 9px;line-height:1.5;max-width:74ch}
  ul.selfcheck input{flex:0 0 16px;width:16px;height:16px;margin:3px 0 0;accent-color:var(--blue);cursor:pointer}
  ul.selfcheck input:focus-visible{outline:2px solid var(--blue-dark);outline-offset:2px}
  ul.selfcheck label{flex:1;min-width:0;cursor:pointer}
  ul.selfcheck .pts{flex:0 0 auto;white-space:nowrap;font-weight:700;color:var(--blue-dark);padding-left:6px}
  .sc-total{font-weight:700;margin:6px 0 0}
  .copywrap{margin:6px 0 0}
  .status{font-size:.9rem; color:var(--ink-soft); margin:8px 0 0}
  .status.ok{color:#1A7F4B; font-weight:700}
  .sumout{display:block; width:100%; min-height:160px; font-family:"IBM Plex Mono",monospace; font-size:.8rem; color:var(--ink); background:var(--paper); border:1px solid var(--line); border-radius:5px; padding:10px 12px; margin-top:4px}
  .storenote{display:none; font-size:.9rem; color:var(--blaze); margin:8px 0 0}
  .instructor{margin-top:22px; text-align:center; font-size:.9rem}
  .instructor .nm{font-weight:700}
  .instructor a,.feedback-note a{color:var(--blue-dark)}
  .feedback-note{margin:18px 0 0; padding-top:14px; border-top:1px solid var(--line); font-size:.86rem; color:var(--ink-soft); text-align:center}
  .page-footer{margin-top:16px; font-size:.78rem; color:var(--ink-soft); text-align:center}
  .page-footer img{height:20px; opacity:.55; vertical-align:middle; margin-right:8px}
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .status.ok{color:#6FCF97} }
  @media (max-width:520px){
    .page{padding:14px 16px 40px}
    .hero-inner{padding:26px 20px 24px}
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation:none !important; transition:none !important}
  }
  @media print{
    body{background:#fff; color:#000; font-size:11.5pt}
    .canvasbar,.crumb,.pagenav,.copybtn,.btn,.airow,.guiderow,.choose,.dojo-only{display:none !important}
    .hero{background:none; color:#000; border:0}
    .hero h1,.hero .intro,.hero .kicker{color:#000}
    .hero-inner{padding:0 0 12px}
    textarea.box{border:1px solid #999; background:none}
    a{color:#000}
  }

  /* this page */
  .accentline{color:var(--blaze); margin-top:12px}
  .accentline b{color:var(--blaze)}
  textarea.box.large{min-height:240px}
  textarea.box::placeholder{color:var(--ink-soft); opacity:1; font-style:italic}
  .moreex{margin:10px 0 0; border:1px solid var(--line); border-radius:5px; background:var(--paper); padding:0 14px; font-size:.93rem}
  .moreex > summary{cursor:pointer; padding:9px 0; font-weight:700}
  .moreex blockquote{margin:0 0 12px; padding:8px 12px; border-left:3px solid var(--line); color:var(--ink-soft); font-style:italic; line-height:1.55}
  .stepgrid{display:grid; gap:18px 24px; margin-top:4px}
  .stepgrid > .g-s1{grid-area:s1} .stepgrid > .g-s2{grid-area:s2} .stepgrid > .g-s3{grid-area:s3}
  .stepgrid > .g-cards{grid-area:cards} .stepgrid > .g-pick{grid-area:pick} .stepgrid > .g-why{grid-area:why}
  .stepgrid{grid-template-areas:"s1" "s2" "s3" "cards" "pick" "why"}
  @media (min-width:900px){
    .stepgrid{grid-template-columns:minmax(0,2fr) minmax(0,1fr); grid-template-areas:"s1 ." "s2 ." "s3 ." "cards ." "pick ." "why ."; align-items:start}
  }
  .stepgrid h3{font-size:1.22rem; font-weight:650; margin:10px 0 8px}
  .g-s1 h3{margin-top:4px}
  .stepgrid .tasks{list-style:none; margin:0; padding:0; display:grid; gap:12px}
  .pathcards .excard p{margin:0}
  fieldset.pick{border:0; margin:0; padding:0; min-width:0}
  fieldset.pick legend{padding:0; margin:0 0 6px; font-size:.92rem}
  .radios{display:flex; flex-wrap:wrap; gap:10px 22px}
  .radios label{display:inline-flex; align-items:center; gap:8px; cursor:pointer; font-weight:700; font-family:"IBM Plex Mono",monospace}
  .radios input{width:20px; height:20px; margin:0; accent-color:var(--tc); cursor:pointer}
  .radios input:focus-visible{outline:3px solid var(--blaze); outline-offset:2px}

  /* hover text (glossary bubbles) */
  .excard{position:relative}
  .gl{display:inline}
  .gt{font:inherit; color:inherit; background:none; border:0; border-bottom:1.5px dashed var(--tc); padding:0; margin:0; cursor:help; line-height:inherit}
  .gt:focus-visible{outline:3px solid var(--blaze); outline-offset:2px; border-radius:2px}
  .bub{display:none; position:absolute; left:10px; right:10px; z-index:30; margin-top:6px; background:var(--card); color:var(--ink); border:1px solid var(--line); border-left:4px solid var(--tc); border-radius:6px; box-shadow:0 8px 22px rgba(0,0,0,.18); padding:10px 13px; font-size:.88rem; line-height:1.5; font-style:normal; font-weight:400; text-align:left}
  .gl:hover > .bub, .gl:focus-within > .bub{display:block}
  .bub .bt{display:block; margin:0 0 5px; font-size:.95rem}
  .bub .br{display:block; margin:0 0 5px}
  @media print{ .bub{display:none !important} .moreex{display:block} }
</style>
